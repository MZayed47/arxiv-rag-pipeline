# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=arxiv_db
DB_USER=postgres
DB_PASSWORD=postgres

# Host port that Postgres is published on (docker-compose only)
DB_PORT_HOST=5432

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=5088
LOG_LEVEL=INFO
RUN_MIGRATIONS_ON_STARTUP=true

# ---------------------------------------------------------------------------
# arXiv ingestion
# ---------------------------------------------------------------------------
ARXIV_CATEGORIES=cs.AI,cs.LG,cs.CL,cs.CV,cs.IR
ARXIV_PAPERS_PER_CATEGORY=200
ARXIV_BATCH_SIZE=200
ARXIV_REQUEST_DELAY=3.0
ARXIV_CONTACT_EMAIL=mashrukh.zayed.official@gmail.com

# ---------------------------------------------------------------------------
# Embeddings (local, no API key required)
# Changing the model means changing EMBEDDING_DIM and migration 0001.
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64

# ---------------------------------------------------------------------------
# LLM for answer generation — provider is "gemini" or "openai"
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# RAG tuning
# ---------------------------------------------------------------------------
RAG_TOP_K=5
RAG_VECTOR_CANDIDATES=25
RAG_KEYWORD_CANDIDATES=25
RAG_MIN_SIMILARITY=0.25
